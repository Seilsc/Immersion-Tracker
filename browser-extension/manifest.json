{
  "manifest_version": 3,
  "name": "Immersion Tracker — YouTube Auto-Track",
  "version": "1.0.0",
  "description": "Auto-detecta el idioma de videos de YouTube y registra sesiones de inmersión en Immersion Tracker.",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["youtube-api-reader.js"],
    "matches": ["https://www.youtube.com/*"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
